  "components": {
    "schemas": {
      "CreateCategoryDto": {
        "required": [
          "categoryName"
        ],
        "type": "object",
        "properties": {
          "categoryName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 200,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateEventDto": {
        "required": [
          "categoryID",
          "eventDate",
          "eventName",
          "location",
          "province",
          "startTime",
          "status"
        ],
        "type": "object",
        "properties": {
          "eventName": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "type": "string",
            "nullable": true
          },
          "categoryID": {
            "type": "integer",
            "format": "int32"
          },
          "eventDate": {
            "type": "string",
            "format": "date-time"
          },
          "startTime": {
            "type": "string",
            "format": "date-span"
          },
          "location": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "province": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "entryFee": {
            "maximum": 100000,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "maxParticipants": {
            "maximum": 1000000,
            "minimum": 1,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "status": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "CreateRouteDto": {
        "required": [
          "eventID",
          "finishPoint",
          "routeName",
          "startPoint"
        ],
        "type": "object",
        "properties": {
          "eventID": {
            "type": "integer",
            "format": "int32"
          },
          "routeName": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
          },
          "distanceKm": {
            "maximum": 10000,
            "minimum": 0.01,
            "type": "number",
            "format": "double"
          },
          "elevationGainM": {
            "maximum": 100000,
            "minimum": 0,
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "startPoint": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "finishPoint": {
            "maxLength": 150,
            "minLength": 1,
            "type": "string"
          },
          "routeUrl": {
            "maxLength": 500,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateWeatherDto": {
        "required": [
          "condition",
          "eventID",
          "forecastDate"
        ],
        "type": "object",
        "properties": {
          "eventID": {
            "type": "integer",
            "format": "int32"
          },
          "forecastDate": {
            "type": "string",
            "format": "date-time"
          },
          "temperatureC": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "condition": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
          },
          "windSpeedKmh": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "rainChancePercent": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EnrolmentDto": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "raceNumber": {
            "maxLength": 20,
            "type": "string",
            "nullable": true
          },
          "status": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginDto": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "RegisterDto": {
        "required": [
          "email",
          "firstName",
          "lastName",
          "password",
          "phone",
          "role"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "maxLength": 50,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "maxLength": 150,
            "minLength": 8,
            "type": "string"
          },
          "phone": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          },
          "dateOfBirth": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "gender": {
            "maxLength": 10,
            "type": "string",
            "nullable": true
          },
          "emergencyContact": {
            "maxLength": 20,
            "type": "string",
            "nullable": true
          },
          "organisationName": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          },
          "website": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
